# Minimal agent configuration — customize as needed
agent:
  name: "$AGENT_NAME"
  system_prompt: |
    You are a helpful assistant. Customize this prompt for your use case.
  model: "togetherai::MiniMaxAI/MiniMax-M2.5"
  working_dir: "${AGENT_WORKING_DIR}"
  persistence: "json"
  tools:
    - name: fs
    - name: web
      # headless: true   # optional; default from WEB_TOOL_HEADLESS or true
  # Optional: spawn_subagent tool for ephemeral child agents (subset of parent tools)
  # spawn_subagent: true
  # brain loads by default. To disable: brain: false
  plugins:
    - "todo"
    - "vault"
